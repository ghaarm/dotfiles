# Touying-Folien nach ernaehrung-icu-vortrag.typ.
# Benötigt #slide und #quelle aus der KN-Touying-Präambel.
# Für Textflächen #centered-items einmal in der Präambel definieren
# (Snippet centered-items-definition). Die bisherigen frame-beamer-Trigger bleiben erhalten.

snippet frame "Normale Touying-Folie" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    ${3:Inhalt}
    #quelle([${4:Quellenangabe}])
  ]${0}

snippet slide "Normale Touying-Folie" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    ${3:Inhalt}
    #quelle([${4:Quellenangabe}])
  ]${0}

snippet frame-beamer-basic "Einfache Touying-Folie" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #centered-items(height: 105mm)[
      ${3:Inhalt}
    ]
    #quelle([${4:Quellenangabe}])
  ]${0}

snippet frame-beamer-bullets "Touying-Folie mit Stichpunkten" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #centered-items(height: 105mm)[#item-by-item[
      - ${3:Erster Punkt}
      - ${4:Zweiter Punkt}
      - ${5:Dritter Punkt}
    ]]
    #quelle([${6:Quellenangabe}])
  ]${0}

snippet frame-beamer-enumerate "Touying-Folie mit nummerierter Liste" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #centered-items(height: 105mm)[#item-by-item[
      + ${3:Erster Punkt}
      + ${4:Zweiter Punkt}
      + ${5:Dritter Punkt}
    ]]
    #quelle([${6:Quellenangabe}])
  ]${0}

snippet frame-beamer-2col "Touying-Folie mit zwei Spalten" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #grid(
      columns: (48%, 48%),
      gutter: 4%,
      [#centered-items(height: 105mm)[${3:Linker Inhalt}]],
      [#centered-items(height: 105mm)[${4:Rechter Inhalt}]],
    )
    #quelle([${5:Quellenangabe}])
  ]${0}

snippet frame-beamer-2col-bullets "Touying-Folie mit Stichpunkten in zwei Spalten" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #grid(
      columns: (48%, 48%),
      gutter: 4%,
      [#centered-items(height: 105mm)[#item-by-item[
        - ${3:Punkt links 1}
        - ${4:Punkt links 2}
      ]]],
      [#centered-items(height: 105mm)[#item-by-item[
        - ${5:Punkt rechts 1}
        - ${6:Punkt rechts 2}
      ]]],
    )
    #quelle([${7:Quellenangabe}])
  ]${0}

snippet frame-beamer-compare "Vergleich in zwei Spalten" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #grid(
      columns: (48%, 48%),
      gutter: 4%,
      [#centered-items(height: 105mm)[*${3:Links}* #linebreak() ${4:Linker Inhalt}]],
      [#centered-items(height: 105mm)[*${5:Rechts}* #linebreak() ${6:Rechter Inhalt}]],
    )
    #quelle([${7:Quellenangabe}])
  ]${0}

snippet frame-beamer-img-left "Bild links, Text rechts" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #grid(
      columns: (48%, 48%),
      gutter: 4%,
      [#image("${3:bild.png}", width: 100%, height: 105mm, fit: "contain")],
      [#centered-items(height: 105mm)[#item-by-item[
        - ${4:Erster Punkt}
        - ${5:Zweiter Punkt}
      ]]],
    )
    #quelle([${6:Quellenangabe}])
  ]${0}

snippet frame-beamer-img-right "Text links, Bild rechts" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #grid(
      columns: (48%, 48%),
      gutter: 4%,
      [#centered-items(height: 105mm)[#item-by-item[
        - ${3:Erster Punkt}
        - ${4:Zweiter Punkt}
      ]]],
      [#image("${5:bild.png}", width: 100%, height: 105mm, fit: "contain")],
    )
    #quelle([${6:Quellenangabe}])
  ]${0}

snippet frame-beamer-img-top "Bild oben, Text unten" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #align(center)[#image("${3:bild.png}", width: 100%, height: 75mm, fit: "contain")]
    #v(5mm)
    #centered-items(height: 30mm)[${4:Text unter dem Bild}]
    #quelle([${5:Quellenangabe}])
  ]${0}

snippet frame-beamer-2img-text "Zwei Bilder oben, Text unten" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #grid(
      columns: (48%, 48%),
      gutter: 4%,
      [#image("${3:links.png}", width: 100%, height: 72mm, fit: "contain")],
      [#image("${4:rechts.png}", width: 100%, height: 72mm, fit: "contain")],
    )
    #v(5mm)
    #centered-items(height: 30mm)[${5:Text unter den Bildern}]
    #quelle([${6:Quellenangabe}])
  ]${0}

snippet frame-beamer-2img "Zwei Bilder nebeneinander" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: ${2:18pt})
    #grid(
      columns: (48%, 48%),
      gutter: 4%,
      [
        #image("${3:links.png}", width: 100%, height: 95mm, fit: "contain")
        #align(center)[#text(size: 12pt)[${4:Beschriftung links}]]
      ],
      [
        #image("${5:rechts.png}", width: 100%, height: 95mm, fit: "contain")
        #align(center)[#text(size: 12pt)[${6:Beschriftung rechts}]]
      ],
    )
    #quelle([${7:Quellenangabe}])
  ]${0}

snippet frame-beamer-plain-img "Bildfolie" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #align(center + horizon)[#image("${2:bild.png}", width: 100%, height: 105mm, fit: "contain")]
    #quelle([${3:Bildquelle}])
  ]${0}

snippet frame-beamer-section "Abschnittsfolie" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Abschnitt}]))[
    #box(width: 100%, height: 108mm)[
      #align(center + horizon)[#text(size: 29pt, weight: "bold")[${2:Kernaussage}]]
    ]
    #quelle([${3:Quellenangabe}])
  ]${0}

snippet centered-items "Vertikal zentrierte Textfläche"
  #centered-items(height: ${1:105mm})[
    ${2:Inhalt}
  ]${0}

snippet centered-items-bullets "Vertikal zentrierte Stichpunkte"
  #centered-items(height: ${1:105mm})[#item-by-item[
    - ${2:Erster Punkt}
    - ${3:Zweiter Punkt}
  ]]${0}

snippet centered-items-definition "Hilfsfunktion centered-items für die Präambel" b
  #let centered-items(body, height: none) = {
    if height == none {
      align(left + horizon, body)
    } else {
      box(
        width: 100%,
        height: height,
        align(left + horizon, body),
      )
    }
  }${0}

snippet bemit "Hervorgehobener Folienpunkt" b
  *${1:Begriff}* ${2:Aussage}${0}

snippet block-beamer "Hervorgehobener Block" b
  #rect(width: 100%, inset: 8pt, radius: 4pt, fill: rgb("eef3f7"))[
    *${1:Titel}* #linebreak()
    ${2:Inhalt}
  ]${0}

snippet alertblock-beamer "Warnblock" b
  #rect(width: 100%, inset: 8pt, radius: 4pt, fill: rgb("fcebea"))[
    *${1:Titel}* #linebreak()
    ${2:Inhalt}
  ]${0}

snippet exampleblock-beamer "Beispielblock" b
  #rect(width: 100%, inset: 8pt, radius: 4pt, fill: rgb("edf6ed"))[
    *${1:Titel}* #linebreak()
    ${2:Inhalt}
  ]${0}

snippet takehome-beamer "Kernaussage" b
  #rect(width: 100%, inset: 8pt, radius: 4pt, fill: rgb("eef3f7"))[
    *Kernaussage:* ${1:Text}
  ]${0}

snippet frame-beamer-formula "Folie mit großer Formel" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: 18pt)
    #align(center + horizon)[#text(size: 30pt)[$ ${2:a + b} $]]
    #quelle([${3:Quellenangabe}])
  ]${0}

snippet frame-beamer-formula-example "Formel mit Beispiel" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: 18pt)
    #align(center)[#text(size: 30pt)[$ ${2:a + b} $]]
    #v(8mm)
    #grid(
      columns: (1fr, 1fr, 1fr),
      gutter: 6mm,
      [*${3:Schritt 1}* #linebreak() ${4:Wert 1}],
      [*${5:Schritt 2}* #linebreak() ${6:Wert 2}],
      [*${7:Schritt 3}* #linebreak() ${8:Wert 3}],
    )
    #quelle([${9:Quellenangabe}])
  ]${0}

snippet frame-beamer-takehome "Folie mit Kernaussage" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Folientitel}]))[
    #set text(size: 18pt)
    #centered-items(height: 90mm)[${2:Inhalt}]
    #rect(width: 100%, inset: 8pt, fill: rgb("eef3f7"))[*Kernaussage:* ${3:Text}]
    #quelle([${4:Quellenangabe}])
  ]${0}

snippet frame-beamer-final "Schlussfolie" b
  #slide(title: text(size: 22pt, weight: "regular", [${1:Zusammenfassung}]))[
    #set text(size: 18pt)
    #centered-items(height: 105mm)[#item-by-item[
      - ${2:Erste Aussage}
      - ${3:Zweite Aussage}
      - ${4:Dritte Aussage}
    ]]
    #quelle([${5:Quellenangabe}])
  ]${0}

snippet source-beamer "Quellenangabe auf Touying-Folie" b
  #quelle([${1:Quellenangabe}])${0}

snippet cite-beamer "Zitat mit manueller Seitenzahl"
  @${1:key}, S. ${2:seite}${0}

snippet cite-beamer-biblatex "Zitat mit Seitenzahl"
  #cite(<${1:key}>, supplement: [S. ${2:seite}])${0}

snippet cite-touying "Quelle mit Zitat auf Touying-Folie"
  #quelle([#cite(<${1:key}>, supplement: [S. ${2:seite}]).])${0}

snippet beamer-video-extern "Link zu externem Video"
  #link("videos/${1:video.mp4}")[${2:Video abspielen}]${0}

snippet png-beamer-plain "Bild auf Folie" b
  #image("${1:bild.png}", width: 100%, height: 105mm, fit: "contain")${0}

snippet beamer-scriptsize-8pt-umbruch "Kleiner Text mit Umbruch" b
  #text(size: 8pt)[${1:Text}]${0}
