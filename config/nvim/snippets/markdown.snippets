# Markdown

# Includes octopress (http://octopress.org/) snippets

# The suffix `c` stands for "Clipboard".


extends html
extends markdown-work-gpt

snippet link:#[ "link md"
	[${1:text}](${2:address})
snippet [*
	[${1:link}](${2:`@*`})
snippet [c
	[${1:link}](${2:`@+`})
snippet ["
	[${1:text}](https://${2:address} "${3:title}")
snippet ["*
	[${1:link}](${2:`@*`} "${3:title}")
snippet ["c
	[${1:link}](${2:`@+`} "${3:title}")
snippet [:
	[${1:id}]: https://${2:url}

snippet [:*
	[${1:id}]: ${2:`@*`}

snippet [:c
	[${1:id}]: ${2:`@+`}

snippet [:"
	[${1:id}]: https://${2:url} "${3:title}"

snippet [:"*
	[${1:id}]: ${2:`@*`} "${3:title}"

snippet [:"c
	[${1:id}]: ${2:`@+`} "${3:title}"

snippet ![
	![${1:alttext}](${2:/images/image.jpg})
snippet ![*
	![${1:alt}](${2:`@*`})
snippet ![c
	![${1:alt}](${2:`@+`})
snippet !["
	![${1:alttext}](${2:/images/image.jpg} "${3:title}")
snippet !["*
	![${1:alt}](${2:`@*`} "${3:title}")
snippet !["c
	![${1:alt}](${2:`@+`} "${3:title}")
snippet ![:
	![${1:id}]: ${2:url}

snippet ![:*
	![${1:id}]: ${2:`@*`}

snippet ![:"
	![${1:id}]: ${2:url} "${3:title}"

snippet ![:"*
	![${1:id}]: ${2:`@*`} "${3:title}"

snippet ![:"c
	![${1:id}]: ${2:`@+`} "${3:title}"

snippet <
	<http://${1:url}>
snippet <*
	<`@*`>
snippet <c
	<`@+`>
snippet ** Bold
	**$0**
snippet __ Bold
	__$0__
snippet --- Front matter
	---
	$0
	---
snippet ====
	`repeat('=', strlen(getline(line('.') - 3)))`

	${0}
snippet -
	-   ${0}
snippet ----
	`repeat('-', strlen(getline(line('.') - 3)))`

	${0}
snippet blockquote
	{% blockquote %}
	${0:quote}
	{% endblockquote %}

snippet blockquote-author
	{% blockquote ${1:author}, ${2:title} %}
	${0:quote}
	{% endblockquote %}

snippet blockquote-link
	{% blockquote ${1:author} ${2:URL} ${3:link_text} %}
	${0:quote}
	{% endblockquote %}

snippet ```
	\`\`\`${1}
	${0:${VISUAL}}
	\`\`\`

# Language.
snippet ```l
	\`\`\`${1:language}
	${2:code}
	\`\`\`

snippet codeblock-short
	{% codeblock %}
	${0:code_snippet}
	{% endcodeblock %}

snippet codeblock-full
	{% codeblock ${1:title} lang:${2:language} ${3:URL} ${4:link_text} %}
	${0:code_snippet}
	{% endcodeblock %}

snippet gist-full
	{% gist ${1:gist_id} ${0:filename} %}

snippet gist-short
	{% gist ${0:gist_id} %}

snippet img
	{% img ${1:class} ${2:URL} ${3:width} ${4:height} ${5:title_text} ${0:alt_text} %}

snippet youtube
	{% youtube ${0:video_id} %}

snippet tb
	|  ${0:factors}      |    ${1:a}       |  ${2:b}   	|
	| ------------- |-------------  | ------- |
	|    ${3:f1}    |    Y          | N       |
	|    ${4:f2}    |    Y          | N       |

# The quote should appear only once in the text. It is inherently part of it.
# See http://octopress.org/docs/plugins/pullquote/ for more info.

snippet pullquote
	{% pullquote %}
	${1:text} {" ${2:quote} "} ${0:text}
	{% endpullquote %}

# Definition lists
snippet : Definition list
	$1
	: $0
snippet :: Alternate definition list
	$1
	  - $0 

snippet todo "TODO Markdown"
  <!-- TODO: ${0}  -->

snippet todo-agent "TODO Agent Markdown"
  <!-- TODO: [AGENT] ${0}  -->

snippet todo-user "TODO USER Markdown"
  <!-- TODO: [USER] ${0}  -->

snippet note "NOTE Markdown"
  <!-- NOTE: ${0}  -->

snippet memo "MEMO Markdown"
  <!-- MEMO: ${0}  -->

snippet pngmd "png Markdown"
	![${1:Beschreibung}](${2:/images/image.png})

snippet yaml-for-link "yaml link cornflower blue"
  ---
  header-includes: |
    \usepackage{xcolor}
    \definecolor{cornflowerblue}{HTML}{6495ED}
  ---

snippet link-md-cornflowerblue-for-latex "link markdown cornflower-blue for latex"
  [\textcolor{cornflowerblue}{${1:Text}}](${2:Link})

snippet yaml-date "yaml mit automatischem Datum"
  ---
  title: "${1:Titel}"
  date: Stand \today
  author: "Golo"
  lang: de-DE
  ---

snippet yaml "yaml markdown"
  ---
  title: "${1:Titel}"
  date: ${2:Datum}
  author: "Golo"
  lang: de-DE
  ---

snippet yaml-zotcite-foot "yaml markdown zotcite footnotes"
  ---
  title: "${1:Titel}"
  date: ${2:Datum}
  # date: Stand \today
  author: "G. Haarmeyer"
  lang: de-DE
  bibliography: zotcite.bib
  zotcite-key-type: better-bibtex
  # klassische Fußnoten
  csl: /Users/g/Zotero/styles/chicago-notes-bibliography.csl
  # nach dem ersten Vollzitat verkürzte Folgezitate
  # csl: /Users/g/Zotero/styles/chicago-shortened-notes-bibliography.csl
  ---
