    [Stimme voll zu], [Stimme zu], [Stimme eher zu],
    [Stimme eher nicht zu], [Stimme nicht zu], [Stimme überhaupt nicht zu],
    [1], [2], [3], [4], [5], [6],
    [☐], [☐], [☐], [☐], [☐], [☐],
  )

  #let likertzustimmung = table(
    columns: 6,
    align: center,
    [Stimme voll zu], [Stimme zu], [Stimme eher zu],
    [Stimme eher nicht zu], [Stimme nicht zu], [Stimme überhaupt nicht zu],
    [☐], [☐], [☐], [☐], [☐], [☐],
  )
  ${0}

snippet signaturelatex "Unterschrift als Bild" b
  #image("${1:unterschrift.png}", width: ${2:30%})${0}

snippet empfänger "Empfängeranschrift" b
  ${1:Name} \\
  ${2:Straße} \\
  ${3:PLZ Ort}${0}
