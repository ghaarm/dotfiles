  )

  #let likertzahlen = table(
    columns: 6,
    align: center,
    [1], [2], [3], [4], [5], [6],
    [☐], [☐], [☐], [☐], [☐], [☐],
  )

  #let likertzustimmungmitzahlen = table(
    columns: 6,
