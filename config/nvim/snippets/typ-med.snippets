# Medizinische Kürzel aus tex-med.snippets als Typst-Markup/Mathematik.
snippet vfvj "Vf - Vj"
  V#sub[f] – V#sub[j]${0}

snippet vavf "Va - Vf"
  V#sub[a] – V#sub[f]${0}

snippet fdo2 "FdO₂"
  $F_"d" "O"_2$${0}

snippet fio2 "FiO₂"
  $F_"i" "O"_2$${0}

snippet spo2 "SpO₂"
  $S_"p" "O"_2$${0}

snippet sao2 "SaO₂"
  $S_"a" "O"_2$${0}

snippet co2 "CO₂"
  CO₂${0}

snippet o2 "O₂"
  O₂${0}

snippet scvo2 "ScvO₂"
  $S_"cv" "O"_2$${0}

snippet vco2 "VCO₂"
  $V "CO"_2$${0}

snippet vco2dot "V̇CO₂"
  $dot(V) "CO"_2$${0}

snippet vo2 "VO₂"
  $V "O"_2$${0}

snippet vo2dot "V̇O₂"
  $dot(V) "O"_2$${0}

snippet etco2 "etCO₂"
  $"etCO"_2$${0}

snippet pinsp "P insp"
  $P_"insp"$${0}

snippet ppeak "P peak"
  $P_"peak"$${0}

snippet pplat "P plat"
  $P_"plat"$${0}

snippet paw "P AW"
  $P_"AW"$${0}

snippet ptrachea "P Trachea"
  $P_"Trachea"$${0}

snippet pmus "P Muskel"
  $P_"Muskel"$${0}

snippet palv "P alv"
  $P_"alv"$${0}

snippet peepi "PEEP i"
  $"PEEP"_"i"$${0}

snippet peeptot "PEEP total"
  $"PEEP"_"tot"$${0}

snippet peepext "PEEP extern"
  $"PEEP"_"extern"$${0}

snippet ti "T i"
  $T_"i"$${0}

snippet timax "T imax"
  $T_"imax"$${0}

snippet pip "P ip"
  $P_"ip"$${0}

snippet psupp "Delta P supp"
  $Delta P_"supp"$${0}

snippet dpsupp "Delta P supp"
  $Delta P_"supp"$${0}

snippet dp "Delta P"
  $Delta P$${0}

snippet dpdrive "Delta P drive"
  $Delta P_"drive"$${0}

snippet dptubus "Delta P Tubus"
  $Delta P_"Tubus"$${0}

snippet vt "V t"
  $"V"_"t"$${0}

snippet vti "V ti"
  $"V"_"ti"$${0}

snippet vte "V te"
  $"V"_"te"$${0}

snippet vds "V ds"
  $"V"_"ds"$${0}

snippet paco2 "PaCO₂"
  $P_"a" "CO"_2$${0}

snippet paco2A "PACO₂"
  $P_"A" "CO"_2$${0}

snippet petco2 "PETCO₂"
  $P_"ET" "CO"_2$${0}

snippet peco2bar "P E quer CO₂"
  $P_(bar("E")) "CO"_2$${0}

snippet siii "S III"
  $S_"III"$${0}

snippet sii "S II"
  $S_"II"$${0}
