snippet pdfinclude-anhang "pdf direkt unter Anhang"
  \includepdf[
    pages=1,
    scale=0.9,
    pagecommand={\section{Anhang}\label{sec:Anhang}\subsection{${1:name-für-toc}}%
      \label{sub:${1}}
      \thispagestyle{plain}}
  ]{${2:name}.pdf}

  \includepdf[
    pages=2-,
    scale=0.9,
    pagecommand={\thispagestyle{plain}}
  ]{${2}.pdf}



# Linie
snippet linie "linie" 
	\rule{${1:Länge}cm}{${2:Breite}mm}
	${0}
#

# Lüccke
snippet lücke "lücke"
  \hspace{${1:Länge}cm} ${0}
#

# Tabelle
snippet tabelle3x3 "tabelle 3x4"
  \begin{table}[H]
	 \centering
	 \caption{${1:Titel der Tabelle}}
		\label{tab:${2:$1}}
		  \begin{tabular}{|l|c|c|}
			 \hline
			 ${3:\ignore{überschrift 1}} & ${4:überschrift 2} & ${5:überschrift 3} \\\\
			 \hline
			 ${6:Zelle} & Zelle & Zelle \\\\
			 \hline
			 Zelle & Zelle & Zelle \\\\
			 \hline
			 Zelle & Zelle & Zelle \\\\
			 \hline
		  \end{tabular}
  \end{table}
#


# Tabelle
snippet tabelle2x3 "tabelle 2x3"
  \begin{table}[H]
	 \centering
	 \caption{${1:Titel der Tabelle}}
		\label{tab:${2:$1}}
		  \begin{tabular}{|l|c|}
			 \hline
			 ${3:\ignore{überschrift 1}} & ${4:überschrift 2} \\\\
			 \hline
			 ${6:Zelle} & Zelle \\\\
			 \hline
			 Zelle & Zelle \\\\
			 \hline
			 Zelle & Zelle \\\\
			 \hline
		  \end{tabular}
  \end{table}
#
# ignore
snippet ignore "ignore"
  \ignore{${1:wort}}$ ${0}
#

# & escaped in Tabelle
snippet && "& escape"
  \& ${0}
#

# include pdf
snippet inpdf "include pdf"
  \includepdf[pages=-, pagecommand={\thispagestyle{fancy}}]{${1:Datei}}
  ${0}
#

# Link
snippet link "link tex ohne Namen"
  \url{${1:url}${0}}
##

snippet link-name " link tex mit Namen"
	\href{${1:Link}}{${2:Beschreibung}, Stand ${3:Datum}}
#

snippet url "url tex ohne Namen"
  \url{${1:url}${0}}

snippet url-name "url tex mit Namen"
	\href{${1:Link}}{${2:Beschreibung}, Stand ${3:Datum}}
#
# toc Inhaltsverzeichnis
snippet toc "toc und href"
  \hypertarget{toc}{}
  \vspace{-1.5cm}
  % Anpassen der Überschriftsabstände

  %-------------------------- INHALTSVERZEICHNIS ----------------------------  
  % Hyperlinks schwarz für das Inhaltsverzeichnis
  % \hypersetup{linkcolor=black}

  \tableofcontents % Erzeugt das Inhaltsverzeichnis
  \listoftables
  \listoffigures
  % Hyperlinks dunkelrot für den Rest des Dokuments
  \hypersetup{
    linkcolor = red!70!black,
              citecolor = black, % Farbe für Zitate
                urlcolor = blue    % Farbe für URL-Links
  }
  ${0}
